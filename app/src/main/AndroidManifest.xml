<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Skan lokalnej biblioteki muzycznej — patrz DESIGN.md sekcja 1 (bez sieci/chmury). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Powiadomienie odtwarzacza (MediaSessionService) na Androidzie 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Biblioteka w chmurze (Google Drive) — patrz DESIGN.md, sekcja "Chmura". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Radio (Etap 31) — tylko żeby zaproponować stacje z kraju usera; opcjonalna, appka ma
         pełnoprawny ręczny wybór kraju gdy user odmówi lub geokodowanie się nie powiedzie. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".AuroraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Aurora"
        android:supportsRtl="true">

        <!-- Rozpoznanie jako apka mediów przez Android Auto — patrz DESIGN.md sekcja 6. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            configChanges na MainActivity: bez tego obrót ekranu niszczył i odtwarzał całą
            Activity (domyślne zachowanie Androida) — czyli też GLSurfaceView/kontekst EGL
            wizualizera projectM oraz cały stan Compose trzymany przez `remember` (m.in.
            `currentPresetPath`, `visualizerMode`). Zgłoszenie: "odwrócenie ekranu wykrzacza
            wizualizer" — silnik dostawał świeży, pusty start w trakcie przejścia zamiast zwykłej
            zmiany rozmiaru. Compose sam poprawnie re-layoutuje się na nowe wymiary (a
            GLSurfaceView dostaje normalny `onSurfaceChanged`), więc appka nie potrzebuje tu
            żadnej dodatkowej obsługi.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aurora"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Odtwarzanie w tle + powiadomienie z kontrolkami + drzewo przeglądania Android Auto —
             patrz DESIGN.md etap 1 i sekcja 6. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
